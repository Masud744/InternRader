# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Engines
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Email Alerts (Resend or SMTP)
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InternRadar <onboarding@resend.dev>
EMAIL_TO=someone@example.com

# Scraper config
JOB_KEYWORDS=iot,robotics,embedded,embedded systems,web development,backend,fastapi,react,python,ai,machine learning,computer vision
SEARCH_TERMS=python intern,backend intern,machine learning intern,web developer intern,software engineer intern
MAX_RESULTS_PER_SOURCE=30

# Runtime behavior
SEND_EMPTY_DIGEST=true
DRY_RUN=false
